<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Identyfikator motywu -->
    <sys:String x:Key="ThemeName">Dark</sys:String>
    <sys:String x:Key="ThemeIcon">☀️</sys:String>
    <sys:String x:Key="ThemeTooltip">Przełącz na tryb jasny</sys:String>

    <!-- Kolory bazowe -->
    <Color x:Key="BackgroundColor">#0F111A</Color>
    <Color x:Key="SurfaceColor">#1A1D2D</Color>
    <Color x:Key="CardColor">#222638</Color>
    <Color x:Key="CardHoverColor">#282D42</Color>
    <Color x:Key="InputBackgroundColor">#141724</Color>
    <Color x:Key="BorderColor">#2E344D</Color>
    <Color x:Key="BorderFocusColor">#6366F1</Color>

    <!-- Kolory akcentów -->
    <Color x:Key="AccentColor">#6366F1</Color>
    <Color x:Key="AccentHoverColor">#7C7EF4</Color>
    <Color x:Key="AccentPressedColor">#4F46E5</Color>

    <!-- Kolory tekstu -->
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <!-- Kolory statusów -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>

    <!-- Pędzle SolidColor -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="WindowBorderBrush" Color="#2A2F45" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#333A56" />

    <!-- Pędzle paska przewijania (ScrollBar) -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#333A56" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#6366F1" />

    <!-- Gradienty tła i akcentu -->
    <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F111A" Offset="0" />
        <GradientStop Color="#141726" Offset="0.6" />
        <GradientStop Color="#181B2E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6366F1" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="0.5" />
        <GradientStop Color="#A855F7" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryHoverGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7578F8" Offset="0" />
        <GradientStop Color="#9A70F8" Offset="0.5" />
        <GradientStop Color="#B46BF8" Offset="1" />
    </LinearGradientBrush>

    <!-- Cień -->
    <Color x:Key="CardShadowColor">#50000000</Color>

</ResourceDictionary>
