<Window x:Class="PasswordGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordGenerator"
        xmlns:helpers="clr-namespace:PasswordGenerator.Helpers"
        mc:Ignorable="d"
        Title="Generator Haseł"
        Width="630"
        Height="800"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0"
                                     Duration="0:0:0.35" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Zewnętrzny kontener z zaokrąglonymi rogami i cieniem -->
    <Border Background="{DynamicResource WindowGradientBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Direction="270"
                              ShadowDepth="6"
                              Opacity="0.35"
                              Color="{DynamicResource CardShadowColor}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Pasek nagłówka -->
                <RowDefinition Height="Auto" />
                <!-- Główna zawartość z przewijaniem -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- NAGŁÓWEK OKNA Z MOŻLIWOŚCIĄ PRZECIĄGANIA -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    MouseDown="Header_MouseDown"
                    Padding="20,16,16,12"
                    Cursor="Arrow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Tytuł i ikona aplikacji -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38"
                                CornerRadius="10"
                                Background="{DynamicResource PrimaryGradientBrush}"
                                Margin="0,0,12,0">
                            <TextBlock Text="🛡️"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Generator Haseł"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Kryptograficznie bezpieczne i unikalne"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Przyciski akcji okna: Motyw, Minimalizuj, Zamknij -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Przycisk przełączania motywu (Ciemny/Jasny) -->
                        <Button Style="{StaticResource IconActionButtonStyle}"
                                Command="{Binding ToggleThemeCommand}"
                                ToolTip="{Binding ThemeTooltip}"
                                Width="34" Height="34"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding ThemeIcon}" FontSize="15" />
                        </Button>

                        <!-- Minimalizuj -->
                        <Button Style="{StaticResource WindowMinimizeButtonStyle}"
                                Click="Minimize_Click"
                                ToolTip="Minimalizuj okno">
                            <TextBlock Text="—"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Margin="0,0,0,2" />
                        </Button>

                        <!-- Zamknij -->
                        <Button Style="{StaticResource WindowCloseButtonStyle}"
                                Click="Close_Click"
                                ToolTip="Zamknij">
                            <TextBlock Text="✕"
                                       FontWeight="Bold"
                                       FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- GŁÓWNA ZAWARTOŚĆ OKNA -->
            <ScrollViewer Grid.Row="1"
                          helpers:SmoothScrollHelper.IsSmoothScrollEnabled="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Focusable="False"
                          Padding="20,0,16,16"
                          Margin="0,0,4,8">
                <StackPanel>
                    <StackPanel.CacheMode>
                        <BitmapCache EnableClearType="True" />
                    </StackPanel.CacheMode>

                    <!-- KARTA 1: WYGENEROWANE HASŁO -->
                    <Border Style="{StaticResource ModernCardStyle}">
                        <StackPanel>
                            <!-- Górny nagłówek karty z powiadomieniem toast -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="WYGENEROWANE HASŁO"
                                           Style="{StaticResource SectionHeaderStyle}"
                                           Margin="0" />

                                <!-- Dymek potwierdzenia skopiowania -->
                                <Border Background="{DynamicResource SuccessBrush}"
                                        CornerRadius="12"
                                        Padding="10,3"
                                        HorizontalAlignment="Right"
                                        Visibility="{Binding IsCopiedToastVisible, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Margin="0,0,4,0" />
                                        <TextBlock Text="Skopiowano do schowka!" Foreground="#FFFFFF" FontSize="11" FontWeight="Medium" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Pole z hasłem i kwadratowy przycisk Generuj obok paska -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,8"
                                        Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Tekst hasła (z możliwością zaznaczenia) -->
                                        <TextBox Text="{Binding DisplayedPassword, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                                 FontSize="19"
                                                 FontWeight="Bold"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center"
                                                 TextWrapping="Wrap"
                                                 IsTabStop="False"
                                                 Cursor="Hand" />

                                        <!-- Przyciski akcji: Pokaż/Ukryj, Kopiuj -->
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="6,0,0,0">
                                            <Button Style="{StaticResource IconActionButtonStyle}"
                                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                                    ToolTip="Pokaż / ukryj znaki hasła"
                                                    Width="32" Height="32"
                                                    Margin="0,0,4,0">
                                                <TextBlock Text="{Binding VisibilityIcon}" FontSize="13" />
                                            </Button>

                                            <Button Style="{StaticResource IconActionButtonStyle}"
                                                    Command="{Binding CopyCommand}"
                                                    ToolTip="Kopiuj hasło do schowka"
                                                    Width="32" Height="32">
                                                <TextBlock Text="📋" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Button Grid.Column="1"
                                        Style="{StaticResource SquareGenerateButtonStyle}"
                                        Command="{Binding GenerateCommand}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="↻" FontSize="22" FontWeight="Bold" />
                                </Button>
                            </Grid>

                            <!-- WSKAŹNIK SIŁY HASŁA -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Siła hasła: "
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding StrengthLabel}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{Binding StrengthColor}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding EntropyBits, StringFormat='{}{0:F0} bitów'}"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text=" • "
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding CrackTimeEstimate}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Pasek postępu siły hasła -->
                            <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                                         Value="{Binding PasswordStrength}"
                                         Foreground="{Binding StrengthColor}"
                                         Maximum="100" />
                        </StackPanel>
                    </Border>

                    <!-- KARTA 2: DŁUGOŚĆ HASŁA -->
                    <Border Style="{StaticResource ModernCardStyle}">
                        <StackPanel>
                            <!-- Etykieta i wskaźnik wybranej długości -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="DŁUGOŚĆ HASŁA"
                                           Style="{StaticResource SectionHeaderStyle}"
                                           Margin="0" />

                                <!-- Pigułka z wartością -->
                                <Border Background="{DynamicResource AccentBrush}"
                                        CornerRadius="12"
                                        Padding="10,2"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding PasswordLength, StringFormat='{}{0} znaków'}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="Bold" />
                                </Border>
                            </Grid>

                            <!-- Suwak (Slider) 4 - 64 -->
                            <Slider Style="{StaticResource ModernSliderStyle}"
                                    Minimum="4"
                                    Maximum="64"
                                    SmallChange="1"
                                    LargeChange="4"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    Value="{Binding PasswordLength, Mode=TwoWay}"
                                    Margin="0,0,0,12" />

                            <!-- Szybkie presety długości (8, 12, 16, 20, 24, 32) w jednej linii -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource PresetPillButtonStyle}"
                                        Content="8 znaków"
                                        Command="{Binding SetLengthPresetCommand}"
                                        CommandParameter="8" />
                                <Button Style="{StaticResource PresetPillButtonStyle}"
                                        Content="12 znaków"
                                        Command="{Binding SetLengthPresetCommand}"
                                        CommandParameter="12" />
                                <Button Style="{StaticResource PresetPillButtonStyle}"
                                        Content="16 znaków"
                                        Command="{Binding SetLengthPresetCommand}"
                                        CommandParameter="16" />
                                <Button Style="{StaticResource PresetPillButtonStyle}"
                                        Content="20 znaków"
                                        Command="{Binding SetLengthPresetCommand}"
                                        CommandParameter="20" />
                                <Button Style="{StaticResource PresetPillButtonStyle}"
                                        Content="24 znaki"
                                        Command="{Binding SetLengthPresetCommand}"
                                        CommandParameter="24" />
                                <Button Style="{StaticResource PresetPillButtonStyle}"
                                        Content="32 znaki"
                                        Command="{Binding SetLengthPresetCommand}"
                                        CommandParameter="32"
                                        Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- KARTA 3: ZESTAW ZNAKÓW -->
                    <Border Style="{StaticResource ModernCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ZESTAW ZNAKÓW"
                                       Style="{StaticResource SectionHeaderStyle}" />

                            <!-- Wielkie litery -->
                            <CheckBox Style="{StaticResource ModernOptionCheckBoxStyle}"
                                      IsChecked="{Binding IncludeUppercase, Mode=TwoWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Wielkie litery (A-Z)"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Row="1"
                                               Text="ABCDEFGHIJKLMNOPQRSTUVWXYZ"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                            </CheckBox>

                            <!-- Małe litery -->
                            <CheckBox Style="{StaticResource ModernOptionCheckBoxStyle}"
                                      IsChecked="{Binding IncludeLowercase, Mode=TwoWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Małe litery (a-z)"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Row="1"
                                               Text="abcdefghijklmnopqrstuvwxyz"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                            </CheckBox>

                            <!-- Cyfry -->
                            <CheckBox Style="{StaticResource ModernOptionCheckBoxStyle}"
                                      IsChecked="{Binding IncludeDigits, Mode=TwoWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Cyfry (0-9)"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Row="1"
                                               Text="0123456789"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                            </CheckBox>

                            <!-- Znaki specjalne (!@#$%^&*) -->
                            <CheckBox Style="{StaticResource ModernOptionCheckBoxStyle}"
                                      IsChecked="{Binding IncludeSpecial, Mode=TwoWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Znaki specjalne (!@#$%^&amp;*)"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Row="1"
                                               Text="! @ # $ % ^ &amp; *"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                            </CheckBox>

                            <!-- Opcjonalne: Wyklucz podobne znaki -->
                            <CheckBox Style="{StaticResource ModernOptionCheckBoxStyle}"
                                      IsChecked="{Binding ExcludeAmbiguous, Mode=TwoWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Wyklucz podobne znaki"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Row="1"
                                               Text="Eliminuje mylące znaki: 0, O, I, l, 1"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- SEKCJA: OSTATNIO WYGENEROWANE HASŁA (HISTORIA) -->
                    <Expander Header="Historia haseł z tej sesji"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="13"
                              FontWeight="Medium"
                              Margin="0,0,0,8">
                        <Border Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas, monospace"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />

                                                <Button Grid.Column="1"
                                                        Style="{StaticResource HistoryItemButtonStyle}"
                                                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Kopiuj do schowka">
                                                    <TextBlock Text="📋" FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource HistoryItemButtonStyle}"
                                        Command="{Binding ClearHistoryCommand}"
                                        HorizontalAlignment="Right"
                                        Margin="0,6,0,0">
                                    <TextBlock Text="Wyczyść historię" FontSize="11" Foreground="{DynamicResource DangerBrush}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
